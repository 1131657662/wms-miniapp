.detail-root {
  min-height: 100vh;
  width: 100%;
}

.page-detail {
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

.detail-fail {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  box-sizing: border-box;
}

.detail-fail-actions {
  margin-top: 32rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.detail-fail-back {
  border-color: #dcdfe6 !important;
  color: #606266 !important;
}

.detail-loading {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  background: #f0f2f5;
}

.detail-loading-text {
  font-size: 26rpx;
  color: #909399;
}

.detail-hero {
  margin: 16rpx 16rpx 8rpx;
  padding: 28rpx 24rpx 24rpx;
  background: linear-gradient(145deg, #409eff 0%, #66b1ff 55%, #79bbff 100%);
  border-radius: 20rpx;
  box-shadow: 0 12rpx 36rpx rgba(64, 158, 255, 0.28);
}

.detail-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.detail-hero-no {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.02em;
  word-break: break-all;
  line-height: 1.35;
}

.detail-hero-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.detail-hero-dot {
  color: rgba(255, 255, 255, 0.55);
}

.detail-hero-ellipsis {
  flex: 1;
  min-width: 0;
}

.detail-hero-supplier {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
}

.detail-hero-supplier-label {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.75);
  margin-bottom: 6rpx;
  letter-spacing: 0.08em;
}

.detail-hero-supplier-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.45;
}

.detail-section {
  margin-bottom: 8rpx;
}

.ui-section-title--tight {
  padding-bottom: 10rpx;
}

.detail-footer-wrap {
  margin-top: 4rpx;
}

.detail-group {
  margin: 0 16rpx !important;
  border-radius: 16rpx !important;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06) !important;
  border: 1rpx solid rgba(228, 231, 237, 0.65) !important;
}

.detail-items {
  padding-bottom: 8rpx;
}

.item-card {
  position: relative;
  margin: 0 16rpx 16rpx;
  padding: 0;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
  border: 1rpx solid rgba(228, 231, 237, 0.65);
  display: flex;
}

.item-card-accent {
  width: 8rpx;
  flex-shrink: 0;
  border-radius: 16rpx 0 0 16rpx;
  background: linear-gradient(180deg, #409eff 0%, #79bbff 100%);
}

.item-card-body {
  flex: 1;
  min-width: 0;
  padding: 22rpx 24rpx 24rpx 18rpx;
}

.item-card-hd {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.item-idx {
  flex-shrink: 0;
  min-width: 40rpx;
  height: 40rpx;
  margin-top: 4rpx;
  border-radius: 10rpx;
  background: rgba(64, 158, 255, 0.1);
  color: #409eff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.i-title-block {
  flex: 1;
  min-width: 0;
}

.i-r1 {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8rpx;
  row-gap: 6rpx;
}

.i-code,
.i-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
  line-height: 1.4;
}

.i-code {
  flex-shrink: 0;
  max-width: 46%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.i-title-dot {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 400;
  color: #dcdfe6;
  line-height: 1.4;
}

.i-name {
  flex: 1;
  min-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.i-r2 {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed rgba(228, 231, 237, 0.85);
}

.i-model-label {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 400;
  color: #c0c4cc;
}

.i-model-val {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 400;
  color: #909399;
  line-height: 1.45;
  word-break: break-all;
}

.i-r3 {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-top: 14rpx;
  margin-left: 52rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed rgba(228, 231, 237, 0.95);
}

.i-r3-label {
  font-size: 20rpx;
  color: #909399;
  flex-shrink: 0;
}

.i-nums {
  font-size: 30rpx;
  font-weight: 700;
  color: #303133;
}

.i-r4 {
  font-size: 22rpx;
  color: #c0c4cc;
  margin-top: 10rpx;
  margin-left: 52rpx;
  line-height: 1.45;
}

.empty-inline {
  margin: 0 16rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.04);
}

.footer-bar {
  display: flex;
  align-items: stretch;
  margin: 0 16rpx 16rpx;
  padding: 24rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.06);
  border: 1rpx solid rgba(228, 231, 237, 0.65);
}

.footer-block {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.footer-gap {
  width: 1rpx;
  background: rgba(228, 231, 237, 0.95);
  margin: 8rpx 0;
  flex-shrink: 0;
}

.footer-label {
  font-size: 22rpx;
  color: #909399;
}

.footer-val {
  font-size: 34rpx;
  font-weight: 700;
  color: #303133;
}

.print-area {
  padding: 16rpx 16rpx 24rpx;
}

.print-btn {
  height: 96rpx !important;
  font-weight: 600 !important;
  box-shadow: 0 12rpx 28rpx rgba(64, 158, 255, 0.3) !important;
}

.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}
