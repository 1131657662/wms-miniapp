function abs(n) {
  return n < 0 ? -n : n;
}

function parseNum(v) {
  var n = parseFloat(v);
  if (isNaN(n)) {
    return NaN;
  }
  return n;
}

function changeWeightDisplay(item) {
  var w = parseNum(item.change_weight);
  if (isNaN(w)) {
    return item.change_weight;
  }
  if (item.business_type === "check") {
    return 0;
  }
  var q = parseNum(item.change_qty);
  if (!isNaN(q) && q < 0) {
    return -abs(w);
  }
  if (!isNaN(q) && q > 0) {
    return abs(w);
  }
  return w;
}

module.exports.changeWeightDisplay = changeWeightDisplay;
