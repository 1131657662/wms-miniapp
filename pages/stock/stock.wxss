.page-stock {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.toolbar-stock {
  flex-shrink: 0;
}

.stock-search-action {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx 0 20rpx;
  min-height: 64rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #409eff;
  white-space: nowrap;
}

.stock-search-action--hover {
  opacity: 0.62;
}

.scroll-body {
  flex: 1;
  min-height: 0;
}

.scroll-body--pad {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.list-stack {
  padding-top: 8rpx;
}

.stock-filter-panel {
  padding: 12rpx 16rpx 16rpx;
  background: #fff;
}

.stock-filter-inner {
  display: flex;
  align-items: stretch;
  min-height: 80rpx;
  padding: 6rpx 8rpx;
  border-radius: 16rpx;
  background: #f5f7fa;
  border: 1rpx solid rgba(228, 231, 237, 0.95);
  box-sizing: border-box;
  --dropdown-menu-height: 80rpx;
  --dropdown-menu-background-color: transparent;
  --dropdown-menu-box-shadow: none;
  --dropdown-menu-title-font-size: 26rpx;
  --dropdown-menu-title-text-color: #606266;
  --dropdown-menu-title-active-text-color: #409eff;
}

.stock-dd-cols {
  flex: 1;
  display: flex;
  align-items: stretch;
  min-width: 0;
}

.stock-dd-col {
  flex: 1 1 0;
  min-width: 0;
}

.stock-dd-col-gap {
  width: 1rpx;
  align-self: stretch;
  margin: 14rpx 4rpx;
  background: rgba(228, 231, 237, 0.95);
  flex-shrink: 0;
}

.stock-dd-menu-single {
  width: 100%;
}

.stock-dd-title {
  font-weight: 500 !important;
  padding: 0 36rpx 0 16rpx !important;
  max-width: 100% !important;
  box-sizing: border-box !important;
}

.stock-filter-divider {
  width: 1rpx;
  align-self: stretch;
  margin: 14rpx 0;
  background: rgba(228, 231, 237, 0.95);
  flex-shrink: 0;
}

.stock-clear-all {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  margin-left: 2rpx;
  border-radius: 12rpx;
  background: rgba(64, 158, 255, 0.08);
  border: 1rpx solid rgba(64, 158, 255, 0.28);
}

.stock-clear-all--hover {
  opacity: 0.78;
  background: rgba(64, 158, 255, 0.14);
}

.stock-clear-all-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #409eff;
  white-space: nowrap;
}

.card-stock {
  margin: 0 16rpx 16rpx;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.06);
  border: 1rpx solid rgba(228, 231, 237, 0.65);
}

.cr1 {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cr1-tag {
  flex-shrink: 0;
}

.cr1-code {
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
  flex-shrink: 0;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cr1-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #303133;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cr1-name .hl {
  color: #409eff;
}

.cr1-right {
  display: flex;
  align-items: baseline;
  flex-shrink: 0;
}

.n-val {
  font-size: 30rpx;
  font-weight: 700;
  color: #303133;
}

.n-unit {
  font-size: 22rpx;
  color: #909399;
  margin-left: 4rpx;
}

.n-div {
  font-size: 22rpx;
  color: #dcdfe6;
  margin: 0 10rpx;
}

.cr2 {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 1rpx dashed rgba(228, 231, 237, 0.95);
  font-size: 22rpx;
  color: #909399;
  font-weight: 400;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.sep {
  color: #dcdfe6;
}
